    <string name="section_mirror">4 · Espelho e pendrive (MirrorLink)</string>
    <string name="mirror_title">Cockpit Player · Modo Espelho</string>
    <string name="btn_mirror">Abrir Modo Espelho (player na tela do celular)</string>
    <string name="mirror_hint">Use no celular que fica espelhado na tela do carro (MirrorLink) ou num suporte. A trava de velocidade usa o GPS do próprio celular.</string>
    <string name="btn_export">Exportar vídeos para o pendrive</string>
