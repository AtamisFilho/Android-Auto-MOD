    <!-- Exportar p/ pendrive -->
    <string name="export_title">Exportar p/ pendrive</string>
    <string name="export_intro">Copia os vídeos no formato que a central do carro toca (MP4/H.264 + AAC). Cada arquivo é verificado para tocar também nos players nativos do celular (Galaxy/Meus Arquivos/Ficheiros).</string>
    <string name="export_section_target">1 · Destino</string>
    <string name="export_no_target">Nenhum pendrive escolhido.</string>
