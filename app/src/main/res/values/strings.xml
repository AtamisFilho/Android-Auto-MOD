    <string name="export_pick">Escolher pendrive / pasta</string>
    <string name="export_target_hint">Pendrive FAT32 (≤ 32 GB), de preferência na pasta VIDEO. Ligue o pendrive com um adaptador OTG.</string>
    <string name="export_section_videos">2 · Vídeos</string>
    <string name="export_batch">Exportar os 20 mais recentes do WhatsApp</string>
    <string name="export_row_hint">Ou toque num vídeo para exportar só ele.</string>
